DATABASE_URL=postgresql://invest:invest@localhost:5432/invest
LEGACY_SQLITE_PATH=data/invest.db
# Cloud Runなどの公開APIではtrueにし、PostgreSQLとHTTP APIの書き込みを無効化する
DATABASE_READ_ONLY=false
BACKFILL_YEARS=5
CORS_ORIGINS=["http://localhost:3000"]
JQUANTS_API_KEY=
# 日次更新でJ-Quantsを使うか。プランの提供期間を確認した上で有効にする
JQUANTS_DAILY_ENABLED=false
JQUANTS_BASE_URL=https://api.jquants.com/v2
JQUANTS_TIMEOUT_SECONDS=30
# プランのレート制限（回/分）。Free=5 / Light=60 / Standard=120 / Premium=500
JQUANTS_REQUESTS_PER_MINUTE=5
# プランが提供する期間の窓。範囲外を含むリクエストは全体が400で拒否されるため、
# 要求期間をこの窓へ収めてから送る。プラン変更時は両方を設定し直す
JQUANTS_HISTORY_LAG_DAYS=84
JQUANTS_HISTORY_YEARS=2
# 分析層（Parquet）のルート。`gs://bucket/lake` でもローカルパスでもよい。
# **価格と財務はここからしか読まない。** 未設定だと両方のAPIが503を返す。
# 手元で試すときは、rawからParquetを組み立ててそこを指す:
#   python backend/scripts/build_parquet.py --out data/parquet
#   PARQUET_LAKE=data/parquet
PARQUET_LAKE=
RAW_DATA_PATH=data/raw
# rawを永続化するGCS prefix（例 gs://<bucket>/raw）。
# **手元で取得を実行するなら設定する。** rawは原本で、Parquetもここから作り直す。
# 未設定だと取得したrawが手元にしか残らず、その状態のまま気づきにくい。
RAW_DATA_URI=
MANAGEMENT_API_ENABLED=false
MANAGEMENT_API_KEY=
